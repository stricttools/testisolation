dist/
# .selfdoc/ is NOT ignored: it holds the staleness baselines and the manifest.
# Ignoring them makes every checkout its own baseline, so STALE001/DRIFT001 fire
# differently for every person and every CI run. Only the build cache is local.
.stricttools/docs-cache/versions/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
*.log
.DS_Store
coverage/
.rlsbl-notes-*.tmp
.rlsbl/lock
.rlsbl-monorepo/lock
.credentials.json
.*-cache.json
.env
.env.local
*.local-only
