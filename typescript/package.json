{
	"name": "testisolation",
	"version": "0.1.3",
	"type": "module",
	"description": "Uncompromising test isolation: your tests structurally cannot touch your real files, secrets, or git identity -- First-class support for Go, Python with pytest, and TypeScript with Node",
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stricttools/testisolation.git",
		"directory": "typescript"
	},
	"homepage": "https://smmh.dev/testisolation/",
	"bugs": {
		"url": "https://github.com/stricttools/testisolation/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"testing",
		"test-isolation",
		"isolation",
		"sandbox",
		"security",
		"credentials",
		"pytest",
		"node-test",
		"rlsbl"
	]
}
